{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__create_branch",
      "mcp__github__list_branches",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__add_issue_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__pull_request_review_write",
      "mcp__github__resolve_review_thread",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__get_file_contents",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__update_pull_request_branch",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "Bash(uv:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Edit(.claude/**)",
      "Read(.claude/**)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/mypy:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(bash scripts/gates.sh:*)",
      "Bash(scripts/gates.sh:*)",
      "Bash(wc:*)",
      "Bash(comm:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)"
    ],
    "ask": [
      "Edit(/packages/engine/src/bt5/verify.py)",
      "Edit(/packages/engine/src/bt5/core/**)",
      "Edit(/tests/contract/**)",
      "Edit(/tests/invariants/**)",
      "Edit(/tests/data_integrity/**)",
      "Edit(/data/**)",
      "Edit(/benchmarks/**)",
      "Edit(/.github/**)",
      "Edit(/pyproject.toml)",
      "Edit(/uv.lock)"
    ]
  },
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "PYTHONHASHSEED": "0"
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/hooks/statusline.py"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/compact_output.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/push_gate.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/protect_paths.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/push_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ruff_format.sh"
          }
        ]
      }
    ]
  }
}
